# Example environment variables for SmartMedicineReminderSystem
# Do NOT commit real secrets. Copy this file to `.env` locally and fill values.

# Frontend / Vite
VITE_API_URL=http://127.0.0.1:8765
VITE_PUBLIC_URL=https://smart-medicine-reminder-system.vercel.app
VITE_SENTRY_DSN=

# Node / Runtime
NODE_ENV=development
PORT=5173

# Third-party keys
DATABASE_URL=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# Bluetooth / Hardware
HC05_BT_ADDRESS=00:00:00:00:00:00

# Optional: analytics / monitoring
SENTRY_DSN=

# Serial / Emulator
SERIAL_PORT=
SERIAL_BAUD=115200
